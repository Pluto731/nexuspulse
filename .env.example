# ============================================================
# NexusPulse Environment Variables
# ============================================================

# LLM API (DeepSeek / OpenAI Compatible)
LLM_PROVIDER=deepseek
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding API (Optional if using local mock embedding)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Obsidian Vault Path
OBSIDIAN_VAULT_PATH=/Users/pluto/MyNotes/Projects/NexusPulse

# Database URL (Fallback to in-memory/sqlite if postgres is down)
DATABASE_URL=postgresql+asyncpg://pluto:plutolab_secret@localhost:5432/nexuspulse

# Ingestion & Agent Settings
TRIAGE_THRESHOLD=7.0
MAX_CRITIC_ATTEMPTS=3
TIME_DECAY_LAMBDA=0.005
